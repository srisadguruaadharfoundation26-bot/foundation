# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force SVG and web files to always use LF
*.svg text eol=lf
*.html text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf

# Binary media files must never be touched
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
